# ==============================================================================
# CLUTCH – Public Esports Tournament Dashboard
# Environment Configuration
# ==============================================================================

# Google Apps Script Web App API URL (Deployed with "Execute as: Me" & "Who has access: Anyone")
NEXT_PUBLIC_CLUTCH_API_URL=https://script.google.com/macros/s/AKfycbxYOUR_DEPLOYMENT_ID/exec

# Optional: REST endpoint fallback (if using Next.js internal API or CLUTCH Admin API)
NEXT_PUBLIC_API_URL=https://clutch-admin.vercel.app/api

# Set to "true" to force internal verified development fixtures during offline testing
NEXT_PUBLIC_USE_MOCK=false


# Supabase Persistent Cloud Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
