# ==============================================================================
# CLUTCH – Public Esports Tournament Dashboard
# Environment Configuration (Supabase Only)
# ==============================================================================

# Supabase Persistent Cloud Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Required server-only key after applying supabase/secure-tournament-state.sql
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required server-only Super Admin SHA-256 hash. Generate with scripts/admin-password-hash.ps1.
ADMIN_PASSWORD_HASH=replace-with-your-64-character-hash

# Optional server-only fallback; leave empty in production and generate campus keys in /43517.
CLUTCH_DEFAULT_PASSKEYS={}
